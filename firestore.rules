rules_version = '2';

// Likes for KROSS Highlight.
//
// MERGE these blocks into your existing rules (Firebase Console → Firestore → Rules).
// Do not replace your whole ruleset with this file unless you have checked the clip-level
// rule below: whatever uploads clips into `kross_highlight` must still be allowed to write.
// (Uploaders using the Firebase Admin SDK bypass rules entirely.)
service cloud.firestore {
  match /databases/{database}/documents {

    match /kross_highlight/{clipId} {
      // clips stay publicly readable; keep your existing write rule for the uploader here
      allow read: if true;

      // one like per signed-in user per clip; the doc id is the user's uid
      match /likes/{uid} {
        allow read: if true;
        allow create: if request.auth != null
          && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['createdAt'])
          && request.resource.data.createdAt == request.time;
        allow delete: if request.auth != null && request.auth.uid == uid;
      }
    }
  }
}
